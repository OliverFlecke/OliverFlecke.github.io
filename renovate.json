{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"lockFileMaintenance": { "enabled": true },
	"prConcurrentLimit": 5,
	"prHourlyLimit": 0,
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{
			"description": "npm: wait 2 days before raising non-major update PRs",
			"groupName": "package.json non-major updates",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["patch", "minor"],
			"minimumReleaseAge": "2 days",
			"automerge": true,
			"platformAutomerge": true
		},
		{
			"description": "npm: wait 7 days before raising major update PRs",
			"matchManagers": ["npm"],
			"matchUpdateTypes": ["major"],
			"minimumReleaseAge": "7 days"
		}
	]
}
